{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ways.dev/schemas/config-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harnessVersion", "testCommand"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "enforcement": { "enum": ["observe", "enforce"], "description": "observe (default): the commit hook only refuses commits that break a guarantee; enforce: it also refuses commits outside an active work" },
    "review": { "enum": ["required", "none"], "description": "default review policy of new outcomes" },
    "verifierPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "globs of tests and check configuration; removing or changing existing lines, deleting a file, adding a line that skips or focuses tests, or touching check configuration here needs approval; adding tests does not"
    },
    "testMarkers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "extra regular expressions for added lines that disable or narrow tests (besides .skip, .only, xit, @Disabled, pytest.mark.skip...)"
    },
    "testCommand": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "test": { "$ref": "#/$defs/command" },
        "lint": { "$ref": "#/$defs/command" },
        "typecheck": { "$ref": "#/$defs/command" },
        "build": { "$ref": "#/$defs/command" },
        "e2e": { "$ref": "#/$defs/command" },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["test", "lint", "typecheck", "build", "e2e"] }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "setup": { "$ref": "#/$defs/command" },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } }
      }
    },
    "historySince": { "type": "string", "minLength": 7 },
    "evaluation": { "enum": ["clean", "fast"], "description": "clean (default): `ways done` runs in a clean checkout of the commit; fast: in the working tree, leaving the clean run to CI (`ways verify`)" },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signature": { "enum": ["required", "optional"], "description": "required: approvals count only with an SSH signature verified against .ways/allowed_signers of the base" },
        "verifierChanges": { "enum": ["human", "human-or-review"], "description": "who may accept changes to existing tests or check configuration (default human-or-review: the human, or an attested independent review that accepts them)" },
        "criteria": { "enum": ["required", "none"], "description": "required: every new outcome needs the human's approval before it closes" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "enum": ["claude", "pi"] },
        "command": { "$ref": "#/$defs/command", "description": "reads the review prompt on stdin and prints the review JSON" }
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "ready"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "command": { "$ref": "#/$defs/command" },
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "command": { "$ref": "#/$defs/command" },
            "tcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "host": { "type": "string", "minLength": 1 }
              }
            },
            "http": { "type": "string", "pattern": "^https?://" }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000]*\\S[^\\u0000]*$" }
    }
  }
}
