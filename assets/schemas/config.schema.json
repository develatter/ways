{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ways.dev/schemas/config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harnessVersion", "testCommand"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "testCommand": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "test": { "$ref": "#/$defs/command" },
        "lint": { "$ref": "#/$defs/command" },
        "typecheck": { "$ref": "#/$defs/command" },
        "build": { "$ref": "#/$defs/command" },
        "e2e": { "$ref": "#/$defs/command" },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["test", "lint", "typecheck", "build", "e2e"] }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "setup": { "$ref": "#/$defs/command" },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } }
      }
    },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "historySince": { "type": "string", "minLength": 7 },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseBranch", "reconciliationBranchPattern", "relevantPaths", "excludedPaths"],
      "properties": {
        "releaseBranch": { "type": "string", "minLength": 1 },
        "integrationBranch": { "type": "string", "minLength": 1 },
        "reconciliationBranchPattern": { "type": "string", "pattern": "^[^*]*\\*[^*]*$" },
        "relevantPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "ready"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "command": { "$ref": "#/$defs/command" },
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "command": { "$ref": "#/$defs/command" },
            "tcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "host": { "type": "string", "minLength": 1 }
              }
            },
            "http": { "type": "string", "pattern": "^https?://" }
          }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000]*\\S[^\\u0000]*$" }
    }
  }
}
