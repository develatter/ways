{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ways.dev/schemas/state-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harnessVersion", "id", "mode", "status", "baseCommit", "gateCommit", "createdAt", "updatedAt", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "mode": { "enum": ["quick", "plan", "sdd", "outcome"] },
    "status": { "enum": ["active", "blocked", "completed", "cancelled"] },
    "baseCommit": { "type": "string", "minLength": 7 },
    "gateCommit": { "type": "string", "minLength": 7 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "profile": { "enum": ["autonomous", "supervised"] },
    "execution": { "enum": ["inline", "delegated"] },
    "workflowVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "phase": { "enum": ["intake", "explore", "assess", "specify", "plan", "decompose", "implement", "review", "validate", "reconcile-memory", "close"] },
    "lastCompletedPhase": { "$ref": "#/properties/phase" },
    "stage": { "enum": ["execute", "evaluate"] },
    "planPath": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "remediation": { "$ref": "https://ways.dev/schemas/remediation-v1.json#/$defs/metadata" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "https://ways.dev/schemas/task-v1.json" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "outcome" } }, "required": ["mode"] },
      "then": { "properties": { "stage": true }, "required": ["stage"] },
      "else": { "not": { "properties": { "stage": true }, "required": ["stage"] } }
    },
    {
      "if": {
        "properties": { "remediation": true },
        "required": ["remediation"]
      },
      "then": {
        "required": ["attempt"],
        "properties": {
          "attempt": { "const": { "$data": "1/remediation/attempt" } }
        }
      }
    }
  ]
}
